TODO 1: Identify the information the movement process needs.

SET currentRoom = "Entrance Foyer"
SET movementCommand = ""
SET gameOver = FALSE
SET inventory = empty list

TODO 2: Prompt for and receive the player's movement command.

WHILE gameOver = FALSE
OUTPUT "You are currently in the " + currentRoom
OUTPUT "Enter a direction (North, South, East, or West): "
INPUT movementCommand

TODO 3: Validate whether the requested movement is possible from the current room.

IF movementCommand is a valid direction from currentRoom THEN

TODO 4: Describe what happens when the movement command is valid.

    SET currentRoom = connected room in the requested direction
    OUTPUT "You moved to the " + currentRoom

    IF currentRoom = "Attic" AND number of items in inventory &lt; 6 THEN
        OUTPUT "The ghost has caught you! Game over."
        SET gameOver = TRUE
    ELSE IF number of items in inventory = 6 THEN
        OUTPUT "Congratulations! You collected all six items!"
        OUTPUT "You escaped the Haunted Mansion!"
        SET gameOver = TRUE
    END IF

ELSE

TODO 5: Describe what happens when the movement command is invalid.

    OUTPUT "You cannot move in that direction. Please try again."
END IF

TODO 6: Show how movement fits into repeated gameplay.

END WHILE
